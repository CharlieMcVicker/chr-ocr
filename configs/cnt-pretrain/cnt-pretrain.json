{
  "total_epochs": 12,
  "iterations_per_epoch": 200,
  "variations_per_image": 3,
  "error_rate": 0.05,
  "slug": "cnt_pretrain",
  "train_manifest": "training_data/manifest_w_lang.json",
  "model_dir": "training_data/dataset/model",
  "use_dynamic_cnt": true,
  "use_shared_pool": false,
  "cnt_fraction": 0.1,
  "cnt_dir": "training_data/cnt",
  "mixture_ratio": 0.0,
  "mixture_schedule": {
    "enabled": false,
    "start_ratio": 0.5,
    "end_ratio": 1.0,
    "start_epoch": 1,
    "end_epoch": 12
  },
  "pretrain_cnt_cap": 3000,
  "use_cached_cnt": false,
  "cnt_cache_dir": "data_temp/cnt_cache",
  "skip_final_eval": false,
  "skip_cnt_eval": false,
  "learning_rate": 0.001,
  "lr_schedule": "cosine_warmup",
  "lr_decay_rate": 0.5,
  "lr_decay_epochs": 4,
  "lr_warmup_epochs": 2,
  "lr_eta_min": 1e-06,
  "blur_prob": 0.1,
  "shadow_prob": 0.1,
  "distortion_prob": 0.4,
  "dropout_prob": 0.1,
  "bleedthrough_prob": 0.1,
  "distortion_limit": 0.05,
  "page_curl_prob": 0.0,
  "page_curl_direction": "random",
  "page_curl_bending_factor": 0.15,
  "page_curl_compression_factor": 0.5,
  "page_curl_width_ratio": 0.3,
  "cnt_noise": {
    "blur": {
      "prob": 0.6,
      "limit_min": 3,
      "limit_max": 5
    },
    "shadow": {
      "prob": 0.5,
      "dimension": 6
    },
    "distortion": {
      "prob": 0.5,
      "limit": 0.15,
      "elastic_alpha": 1.0,
      "elastic_sigma": 15.0,
      "use_multi_scale": true
    },
    "dropout": {
      "prob": 0.5,
      "holes_min": 1,
      "holes_max": 4,
      "size_min": 4,
      "size_max": 10
    },
    "micro_dropout": {
      "prob": 0.4,
      "holes_min": 20,
      "holes_max": 60,
      "size_min": 1,
      "size_max": 2
    },
    "smudge": {
      "prob": 0.4,
      "intensity": 0.3
    }
  },
  "output_dir": "data_temp/cnt_pretrain/dataset_epoch",
  "train_output_dir": "data_temp/cnt_pretrain/dataset_staged_output",
  "checkpoint_dir": "checkpoints/cnt_pretrain"
}