{
  "base": {
    "config": {
      "total_epochs": 12,
      "iterations_per_epoch": 200,
      "variations_per_image": 3,
      "error_rate": 0.05,
      "use_dynamic_cnt": true,
      "use_shared_pool": true,
      "cnt_fraction": 0.1,
      "mixture_ratio": 0.3,
      "max_cnt_samples": 1500,
      "learning_rate": 0.002,
      "lr_schedule": "step",
      "lr_decay_rate": 0.6,
      "lr_decay_epochs": 3,
      "blur_prob": 0.4,
      "shadow_prob": 0.3,
      "distortion_prob": 0.4,
      "dropout_prob": 0.3,
      "bleedthrough_prob": 0.25,
      "cnt_noise": {
        "blur": {
          "prob": 0.7,
          "limit_min": 3,
          "limit_max": 5
        },
        "shadow": {
          "prob": 0.7,
          "dimension": 6
        },
        "distortion": {
          "prob": 0.8,
          "limit": 0.25,
          "elastic_alpha": 1.0,
          "elastic_sigma": 15.0,
          "use_multi_scale": true
        },
        "dropout": {
          "prob": 0.5,
          "holes_min": 1,
          "holes_max": 4,
          "size_min": 4,
          "size_max": 10
        },
        "micro_dropout": {
          "prob": 0.3,
          "holes_min": 20,
          "holes_max": 60,
          "size_min": 1,
          "size_max": 2
        },
        "smudge": {
          "prob": 0.3,
          "intensity": 0.3
        },
        "page_curl": {
          "prob": 0.0,
          "direction": "random",
          "bending_factor": 0.08,
          "compression_factor": 0.4,
          "width_ratio": 0.25
        }
      },
      "mixture_schedule": {
        "enabled": false,
        "start_ratio": 0.3,
        "end_ratio": 0.8,
        "start_epoch": 1,
        "end_epoch": 12
      }
    },
    "eval_iterations": [800, 1600, 2400]
  },
  "experiments": [
    {
      "id": "true_best_baseline",
      "config": {
        "description": "Replicates the exact local optimum baseline (0.3 mixture ratio, 1500 max CNT, 0.002 learning rate, 0.6/3 step decay) using the fast shared pool structure."
      }
    },
    {
      "id": "sweep_aug_light_noise",
      "config": {
        "description": "Sweeps lighter ranges of the newly introduced physical distortion and ink degradation parameters near the local optimum.",
        "cnt_noise": {
          "micro_dropout": {
            "prob": 0.2,
            "holes_min": 15,
            "holes_max": 45
          },
          "smudge": {
            "prob": 0.2,
            "intensity": 0.2
          },
          "page_curl": {
            "prob": 0.2,
            "bending_factor": 0.05,
            "compression_factor": 0.3
          }
        }
      }
    },
    {
      "id": "sweep_aug_heavy_noise",
      "config": {
        "description": "Sweeps more aggressive ranges of physical distortions, micro-dropout, ink wash, and page curl to evaluate model robustness.",
        "cnt_noise": {
          "distortion": {
            "prob": 0.6,
            "elastic_alpha": 2.0,
            "elastic_sigma": 12.0
          },
          "micro_dropout": {
            "prob": 0.5,
            "holes_min": 35,
            "holes_max": 80,
            "size_max": 3
          },
          "smudge": {
            "prob": 0.5,
            "intensity": 0.45
          },
          "page_curl": {
            "prob": 0.5,
            "bending_factor": 0.12,
            "compression_factor": 0.55
          }
        }
      }
    },
    {
      "id": "sweep_decay_gradual_to_0.9",
      "config": {
        "description": "Gradually decays CNT ratio by increasing Phoenix ratio from the 0.3 optimum up to 0.9 across 12 epochs, with moderate new augmentations.",
        "mixture_schedule": {
          "enabled": true,
          "start_ratio": 0.3,
          "end_ratio": 0.9,
          "start_epoch": 1,
          "end_epoch": 12
        },
        "cnt_noise": {
          "micro_dropout": { "prob": 0.3 },
          "smudge": { "prob": 0.3 },
          "page_curl": {
            "prob": 0.3,
            "bending_factor": 0.08
          }
        }
      }
    },
    {
      "id": "sweep_decay_aggressive_to_0.95",
      "config": {
        "description": "Aggressively decays CNT ratio starting from 0.3 up to 0.95 by epoch 8 (leaving epochs 9-12 as high-fidelity fine-tuning on purely target Phoenix scans), combined with robust physical and ink augmentations.",
        "mixture_schedule": {
          "enabled": true,
          "start_ratio": 0.3,
          "end_ratio": 0.95,
          "start_epoch": 1,
          "end_epoch": 8
        },
        "cnt_noise": {
          "distortion": {
            "prob": 0.5,
            "elastic_alpha": 1.8
          },
          "micro_dropout": { "prob": 0.4 },
          "smudge": { "prob": 0.4 },
          "page_curl": {
            "prob": 0.4,
            "bending_factor": 0.1
          }
        }
      }
    },
    {
      "id": "sweep_page_curl_ranges",
      "config": {
        "description": "Isolated sweep of page curl bending factor range near the optimum to identify the threshold where text line warping begins to degrade OCR performance.",
        "cnt_noise": {
          "page_curl": {
            "prob": 0.6,
            "bending_factor": 0.15,
            "compression_factor": 0.6,
            "width_ratio": 0.35
          }
        }
      }
    },
    {
      "id": "sweep_ink_degradation_ranges",
      "config": {
        "description": "Isolated sweep on ink degradation ranges (smudges and dense high-frequency micro-dropout) to find the limit of training regularizer density.",
        "cnt_noise": {
          "micro_dropout": {
            "prob": 0.4,
            "holes_min": 40,
            "holes_max": 90,
            "size_max": 3
          },
          "smudge": {
            "prob": 0.4,
            "intensity": 0.5
          }
        }
      }
    }
  ]
}
